# Copy this file to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-random-secret
ENVIRONMENT=development

# Leave empty for local/self-hosted use (docker compose on your own machine).
# Set this to a long random string whenever the API is reachable from the
# public internet (see README "Free deployment") -- every request then needs
# a matching `X-API-Key` header, except /api/health.
API_KEY=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=roomsearch
POSTGRES_PASSWORD=roomsearch
POSTGRES_DB=roomsearch
DATABASE_URL=postgresql+psycopg2://roomsearch:roomsearch@postgres:5432/roomsearch

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# How often the scheduler runs a full search, in minutes.
SEARCH_INTERVAL_MINUTES=60

# ---------------------------------------------------------------------------
# Email (SMTP) -- works with Gmail, Outlook, or any generic SMTP server
# ---------------------------------------------------------------------------
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
NOTIFICATION_EMAIL=

# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=<app password, not your normal password>
#
# Outlook example:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USERNAME=you@outlook.com
#   SMTP_PASSWORD=<app password>

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Notification mode: immediate | hourly_digest | daily_digest
# ---------------------------------------------------------------------------
NOTIFICATION_MODE=immediate

# ---------------------------------------------------------------------------
# CORS (comma-separated origins allowed to call the backend API)
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Frontend -> backend URL used for server-side rendering inside the frontend
# container (leave as-is for docker compose)
# ---------------------------------------------------------------------------
BACKEND_URL=http://backend:8000
